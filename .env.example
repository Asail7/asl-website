# Copy this file to .env.local and fill in the value.
#
# Web3Forms access key — free, no server needed.
# Create one at https://web3forms.com (enter your email, they send the key).
# Submissions arrive straight in your inbox.
#
# If this is left empty the contact form still works: it falls back to opening
# the visitor's mail client with the message pre-filled.
NEXT_PUBLIC_WEB3FORMS_KEY=
